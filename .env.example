# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is already covered by .gitignore.

# ---------------------------------------------------------------------------
# Supabase (required)
# Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase is moving from the legacy JWT "anon" key to the newer
# "sb_publishable_..." format. Set whichever one your project shows — the app
# accepts either, preferring the publishable key when both are present.
#
# Both are safe in a browser bundle: Row Level Security, not key secrecy, is
# what protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# NEVER put the service_role / sb_secret_... key in a NEXT_PUBLIC_ variable.
# It bypasses Row Level Security and would be readable by anyone.

# ---------------------------------------------------------------------------
# Site URL (optional)
# Used to build the absolute callback links in confirmation and reset emails.
#
# Leave this UNSET on Vercel: the app then uses Vercel's stable per-branch URL
# for previews and the production domain for production, so Supabase only needs
# configuring once. Set it only for a custom domain or a non-Vercel host.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# OpenAI (required from Phase 5 — AI report generation)
# Server-side only: never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# The model used for drafting. Optional - defaults to the one the installed
# OpenAI SDK documents. Change it if your account does not have that model, or
# to trade quality against cost.
# OPENAI_MODEL=

# The model used for the cleanup pass that runs before drafting - it rewrites
# raw and dictated notes into professional section text. Optional: falls back to
# OPENAI_MODEL, and then to the same default. Set it only to run cleanup on a
# cheaper or faster model than the review.
# OPENAI_CLEANUP_MODEL=

# Points the SDK at an alternative OpenAI-compatible endpoint. Only needed for
# a proxy or for the test stub; leave unset in normal use.
# OPENAI_BASE_URL=
