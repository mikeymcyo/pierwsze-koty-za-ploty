# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is already covered by .gitignore.

# ---------------------------------------------------------------------------
# Supabase (required)
# Project Settings -> API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Site URL (required in production)
# Used to build the absolute callback links in confirmation and reset emails.
# Locally you can leave this as-is; on Vercel set it to your deployed origin.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OpenAI (required from Phase 5 — AI report generation)
# Server-side only: never prefix this with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
